# Django
DJANGO_SECRET_KEY=your-secret-key-here

# Google OAuth
GOOGLE_OAUTH2_CLIENT_ID=your-client-id-here
GOOGLE_OAUTH2_CLIENT_SECRET=your-client-secret-here

# KIS 실계좌 (시세 조회 + 실거래)
KIS_REAL_APP_KEY=your-real-app-key
KIS_REAL_APP_SECRET=your-real-app-secret
KIS_REAL_ACCOUNT_NO=your-account-number

# KIS 모의계좌 (자동매매 테스트)
KIS_VIRTUAL_APP_KEY=your-virtual-app-key
KIS_VIRTUAL_APP_SECRET=your-virtual-app-secret
KIS_VIRTUAL_ACCOUNT_NO=your-virtual-account-number

# 자동매매 모드: REAL 또는 VIRTUAL
KIS_MODE=VIRTUAL

# 텔레그램 매매 체결 알림
# TELEGRAM_BOT_TOKEN: @BotFather에서 생성한 봇 토큰 (예: 123456789:ABCDefGHIJKLmnoPQRstuvWXYZ)
# TELEGRAM_CHAT_ID: 챗ID 확인 방법 → https://core.telegram.org/bots#using-a-bot
# 빈 값이면 알림 기능이 비활성화됩니다
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
